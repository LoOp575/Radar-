# =============================================================
# PumpRadar Vision — environment variables
# Copy this file to .env.local for local dev.
# Set the same keys in Vercel > Project > Settings > Environment Variables.
# Never commit real secrets.
# =============================================================

# --- Database (Supabase Postgres connection string) ---
DATABASE_URL=

# --- Supabase (optional, for client/server features) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# --- Market data APIs ---
COINGECKO_API_KEY=
DEXSCREENER_API_BASE=https://api.dexscreener.com
COINALYZE_API_KEY=
HELIUS_API_KEY=

# --- Chain explorers ---
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
SOLSCAN_API_KEY=

# --- Telegram alert worker ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
